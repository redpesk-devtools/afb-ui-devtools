{
  "name": "afb-ui-devtools",
  "version": "1.1.0",
  "license": "GPLv3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redpesk-devtools/afb-ui-devtools.git"
  },
  "bugs": {
    "url": "https://github.com/redpesk-devtools/afb-ui-devtools/issues"
  },
  "scripts": {
    "ng": "ng",
    "conventional-changelog": "conventional-changelog",
    "build": "ng build --configuration development",
    "watch": "ng build --watch --aot",
    "version": "node set-git-tag.js",
    "set_version": "[ -z \"$VERSION\" ] && export VERSION=$(cat package.json | jq -r .version); sed -i -e \"s/GIT_TAG: .*$/GIT_TAG: '$VERSION'/g\" src/environments/environment.prod.ts",
    "build:prod": "npm run set_version && ng build --configuration production --aot",
    "build:dev": "npm run set_version && ng build",
    "build:tar": "node set-git-tag.js && PREFIX='afb-ui-devtools-prebuild-' VERSION=$(git describe --tags --abbrev=0) && ng build --configuration production --aot && mkdir -p $PREFIX$VERSION && mv dist/* $PREFIX$VERSION/ && tar -czf $PREFIX$VERSION.tar.gz $PREFIX$VERSION && rm -rf $PREFIX$VERSION",
    "test": "ng test",
    "test:coverage": "rimraf coverage && npm run test -- --code-coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint afb-ui-devtools --fix",
    "lint:styles": "stylelint ./src/**/*.scss",
    "lint:ci": "npm run lint && npm run lint:styles",
    "pree2e": "webdriver-manager update --standalone false --gecko false",
    "e2e": "ng e2e",
    "docs": "compodoc -p src/tsconfig.app.json -d docs",
    "docs:serve": "compodoc -p src/tsconfig.app.json -d docs -s",
    "prepush": "npm run lint:ci",
    "release:changelog": "npm run conventional-changelog -- -p angular -i CHANGELOG.md -s",
    "pack": "PKG_NAME=$npm_package_name-$npm_package_version; rm -rf ./dist && npm run lint:ci && npm run build:prod && mv dist $PKG_NAME && tar zcvf $PKG_NAME.tar.gz ./$PKG_NAME/"
  },
  "dependencies": {
    "@angular/animations": "^21.1.0",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/localize": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-browser-dynamic": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@nebular/eva-icons": "^17.0.0",
    "@nebular/theme": "^17.0.0",
    "@redpesk/afb-ws": "^1.0.1",
    "bootstrap": "^5.3.3",
    "chokidar": "^3.4.3",
    "classlist.js": "1.1.20150312",
    "core-js": "2.5.1",
    "eva-icons": "^1.1.3",
    "intl": "1.2.5",
    "nebular-icons": "1.1.0",
    "normalize.css": "6.0.0",
    "pace-js": "1.0.2",
    "popper.js": "^1.16.0",
    "rxjs": "6.6.3",
    "rxjs-compat": "6.3.0",
    "sass": "^1.77.0",
    "tslib": "^2.0.0",
    "web-animations-js": "^2.3.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.1.0",
    "@angular-eslint/builder": "^21.1.0",
    "@angular-eslint/eslint-plugin": "^21.1.0",
    "@angular-eslint/eslint-plugin-template": "^21.1.0",
    "@angular-eslint/schematics": "^21.1.0",
    "@angular-eslint/template-parser": "^21.1.0",
    "@angular/cdk": "^20.2.14",
    "@angular/cli": "^21.1.0",
    "@angular/compiler-cli": "^21.1.0",
    "@angular/language-service": "21.1.0",
    "@types/estree": "^1.0.5",
    "@types/node": "^25.0.9",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "conventional-changelog-cli": "^2.1.1",
    "eslint": "^9.28.0",
    "husky": "0.13.3",
    "npm-run-all": "4.0.2",
    "protractor": "~7.0.0",
    "rimraf": "2.6.1",
    "stylelint": "^16.2.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-scss": "^6.1.0",
    "ts-node": "3.2.2",
    "typescript": "^5.9.3"
  }
}
